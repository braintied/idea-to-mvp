{
  "name": "idea-to-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "prepare": "node scripts/install-git-hooks.mjs",
    "mcp:link": "node scripts/link-mcp.mjs",
    "keys": "node scripts/keys.mjs",
    "verify": "pnpm check",
    "deploy-button": "node scripts/deploy-button-url.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.64",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "ai": "7.0.140",
    "inngest": "4.24.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.33.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "inngest-cli": "^1.46.0",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=22"
  }
}
