# Copy this file to .env.local and fill in the values.
# .env.local is never committed. Add the same values in Vercel →
# Project → Settings → Environment Variables before you deploy.

# Your site's address. Local: http://localhost:3000. On Vercel, leave it unset to use
# the project's Vercel address, or set it to https://yourdomain.com once your domain works.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only, full database access. Never share it.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend → API Keys.
RESEND_API_KEY=re_...
# onboarding@resend.dev works before you own a domain, but only sends to the
# email you signed up to Resend with. After you verify your domain in Resend,
# change it to something like: Your Idea <hello@yourdomain.com>
EMAIL_FROM=Your Idea <onboarding@resend.dev>

# The email you sign in with. Only this person sees the waitlist in the CRM.
OWNER_EMAIL=you@example.com

# DeepSeek → platform.deepseek.com → API keys (top up $2 first). AI_MODEL is a DeepSeek
# model id: deepseek-flash is fast and costs about $0.15 per million input tokens.
DEEPSEEK_API_KEY=sk-...
AI_MODEL=deepseek-flash

# OpenAI → API Keys. Only needed for /design image generation.
OPENAI_API_KEY=sk-...

# Inngest: set automatically when you add the Inngest integration on Vercel.
# Not needed locally (pnpm inngest runs a local dev server).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
