# Copy this file to .env.local and fill in the values.
# .env.local is never committed. Add the same values in Vercel →
# Project → Settings → Environment Variables before you deploy.

# Your site's address. Local: http://localhost:3000. Live: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only, full database access. Never share it.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend → API Keys. EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=re_...
EMAIL_FROM=Your Idea <hello@yourdomain.com>

# The email you sign in with. Only this person sees the waitlist in the CRM.
OWNER_EMAIL=you@example.com

# Anthropic console → API Keys. AI_MODEL is any Claude model id.
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5-5

# Inngest: set automatically when you add the Inngest integration on Vercel.
# Not needed locally (pnpm inngest runs a local dev server).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
