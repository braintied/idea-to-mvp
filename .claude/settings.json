{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm db:types)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__context7",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(pnpm db:push)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-env.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["supabase", "context7", "playwright"],
  "extraKnownMarketplaces": {
    "braintied": {
      "source": {
        "source": "github",
        "repo": "braintied/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "braintied@braintied": true
  }
}
